# TeByPass only needs these two values to boot.
# Everything else (router driver, credentials, feeds, intervals, WireGuard config)
# is stored in SQLite inside the data volume and edited from the web interface.
#
# Copy to .env only if you want to change the defaults.

TEBYPASS_PORT=9384
TEBYPASS_DATABASE_URL=sqlite+aiosqlite:////data/tebypass.db

# ---------------------------------------------------------------------------
# Virtual Gateway sidecar (docker compose --profile gateway)
# ---------------------------------------------------------------------------
# The sidecar takes its own address on the LAN so client devices can use it as
# their default gateway. Create the macvlan network once, attached to the host
# NIC that faces the LAN:
#
#   docker network create -d macvlan \
#     --subnet="$TEBYPASS_LAN_SUBNET" \
#     --gateway="$TEBYPASS_LAN_GATEWAY" \
#     -o parent="$TEBYPASS_LAN_PARENT" \
#     "$TEBYPASS_LAN_NETWORK"
#
# Values below are RFC 5737 documentation placeholders. Replace them with the
# real LAN values (and a free address for the gateway) on the deployment host.
# TEBYPASS_LAN_NETWORK=tebypass-lan
# TEBYPASS_LAN_PARENT=eth0
# TEBYPASS_LAN_SUBNET=192.0.2.0/24
# TEBYPASS_LAN_GATEWAY=192.0.2.1
# TEBYPASS_GATEWAY_IP=192.0.2.26
# TEBYPASS_GATEWAY_MAC=02:42:c0:00:02:1a
# TEBYPASS_GATEWAY_SET=tebypass_targets
